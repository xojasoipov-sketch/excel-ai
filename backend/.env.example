# Never commit the real values in this file. Copy it to .env and fill in the keys.

# ─── AI provider (OpenAI-compatible; currently B.AI serving DeepSeek) ─────────
DEEPSEEK_API_KEY=your_bai_api_key
DEEPSEEK_BASE_URL=https://api.b.ai/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional: enables the Telegram bot.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# ─── Supabase (auth + database) ──────────────────────────────────────────────
# Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key

# ─── Site / accounts ─────────────────────────────────────────────────────────
# This email gets unlimited free access and is the only account that can open /admin.
OWNER_EMAIL=you@example.com
# Public URL of the deployed site (used for Stripe redirects and CORS).
SITE_URL=http://localhost:5173
# Extra allowed CORS origins, comma-separated (local dev ports are allowed by default).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Free-plan daily AI-call allowance for signed-up, non-paying users.
FREE_DAILY_LIMIT=5

# ─── Stripe (card subscriptions) ─────────────────────────────────────────────
# Leave blank to launch without card payments — 100% promo codes still work.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
PLAN_PRICE_USD=5

# ─── Encryption for the admin payout-card field ──────────────────────────────
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CARD_ENCRYPTION_KEY=
