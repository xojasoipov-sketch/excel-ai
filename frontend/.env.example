# Copy to .env (or .env.local) for local development.
# These are PUBLIC values — they ship inside the browser bundle, so never put the
# Supabase service_role key or any Stripe secret key here.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_anon_key

# Leave empty in production (the API is served from the same origin).
# In dev, point it at the local FastAPI server:
VITE_API_URL=http://localhost:8000
